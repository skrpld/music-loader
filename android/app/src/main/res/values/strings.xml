    <string name="existing_keep">Keep</string>
    <string name="existing_outdated">Update outdated</string>
    <string name="existing_all">Update all</string>
    <string name="existing_keep_description">Tracks already in the library stay as they are; only their id is written into the file, so they are found again quickly.</string>
    <string name="existing_outdated_description">Tracks written in an older format, or with an artist that changed since (Artists), are rewritten with the current rules: tags, folders, broken files, lyrics.</string>
    <string name="existing_all_description">Every track already in the library is rewritten with the current rules: tags, folders, broken files, lyrics.</string>
    <string name="existing_outdated_unsupported">Update outdated needs a newer music-loader on the server.</string>
