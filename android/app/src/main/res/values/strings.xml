    <string name="lyrics_off">Off</string>
    <string name="lyrics_strict_description">Only an exact match of artist, title, version and length (±2 s). Nothing is better than the wrong song\'s lyrics.</string>
    <string name="lyrics_loose_description">Fuzzy artist and title match, length difference up to the limit in Settings (10 s by default). When the timing may not fit, only plain text is saved.</string>
    <string name="lyrics_off_description">Lyrics are not looked up.</string>
    <string name="options_title">Options</string>
