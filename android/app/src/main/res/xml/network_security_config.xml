<?xml version="1.0" encoding="utf-8"?>
<!-- The server runs on the user's own machine, usually as plain HTTP in the local network
     or over a VPN, and its address is only known at runtime. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
